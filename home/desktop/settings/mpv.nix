# Convertido de dot_config/mpv/mpv.conf (yocaslu/dotfiles)
colors: {
  hwdec = "auto-safe";
  keep-open = "yes";
  osd-font = "JetBrainsMono Nerd Font";
  osd-font-size = 28;
  osd-color = "${colors.base05}";
  osd-border-color = "${colors.base00}";
  osd-bar-align-y = 0.9;
  sub-color = "${colors.base05}";
  sub-border-color = "${colors.base00}";
}
