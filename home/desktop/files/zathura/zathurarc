# zathura - cores do tema ativo

set default-fg                rgba(@base05-rgb@,1)
set default-bg                rgba(@base00-rgb@,1)

set completion-bg             rgba(@base01-rgb@,1)
set completion-fg             rgba(@base05-rgb@,1)
set completion-highlight-bg   rgba(@base0E-rgb@,1)
set completion-highlight-fg   rgba(@base00-rgb@,1)
set completion-group-bg       rgba(@base00-rgb@,1)
set completion-group-fg       rgba(@base05-rgb@,1)

set statusbar-fg              rgba(@base05-rgb@,1)
set statusbar-bg              rgba(@base00-rgb@,1)
set inputbar-fg               rgba(@base05-rgb@,1)
set inputbar-bg               rgba(@base00-rgb@,1)

set notification-bg           rgba(@base00-rgb@,1)
set notification-fg           rgba(@base05-rgb@,1)
set notification-error-bg     rgba(@base00-rgb@,1)
set notification-error-fg     rgba(@base08-rgb@,1)
set notification-warning-bg   rgba(@base00-rgb@,1)
set notification-warning-fg   rgba(@base0A-rgb@,1)

set recolor                   "true"
set recolor-lightcolor        rgba(@base00-rgb@,1)
set recolor-darkcolor         rgba(@base05-rgb@,1)

set index-fg                  rgba(@base05-rgb@,1)
set index-bg                  rgba(@base00-rgb@,1)
set index-active-fg           rgba(@base05-rgb@,1)
set index-active-bg           rgba(@base01-rgb@,1)

set render-loading-bg         rgba(@base00-rgb@,1)
set render-loading-fg         rgba(@base05-rgb@,1)

set highlight-color           rgba(@base04-rgb@,0.3)
set highlight-fg              rgba(@base05-rgb@,1)
set highlight-active-color    rgba(@base0E-rgb@,0.3)

# Copiar seleção para a área de transferência
set selection-clipboard clipboard
