  sorting = {
    column = "name";
    reverse = false;
    dir-grouping = "none";
  };
  no-symlink = false;
  total-size = false;
  hyperlink = "auto";
  symlink-arrow = "⇒";
  header = false;
  literal = false;
  truncate-owner = {
    after = null;
    marker = "";
  };
}
