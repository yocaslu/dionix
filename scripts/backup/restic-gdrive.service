# /etc/systemd/system/restic-gdrive.service
[Unit]
Description=Backup com restic para o Google Drive
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/restic-gdrive.sh
# Backup em segundo plano: não disputa CPU e disco com os serviços
Nice=19
IOSchedulingClass=idle
